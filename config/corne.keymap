#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <180>;
            global-quick-tap;
        };

        ltq: ltq {
            compatible = "zmk,behavior-hold-tap";
            label = "LTQ";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <600>;
            global-quick-tap;
            quick-tap-ms = <400>;
        };
    };

    combos {
        compatible = "zmk,combos";

        left_bkt {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <4 3>;
            timeout-ms = <50>;
        };

        right_bkt {
            bindings = <&kp RBKT>;
            key-positions = <7 8>;
            timeout-ms = <50>;
        };

        left_par {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <15 16>;
            timeout-ms = <50>;
        };

        right_par {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <19 20>;
            timeout-ms = <50>;
        };

        left_brace {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <27 28>;
            timeout-ms = <50>;
        };

        right_brace {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <32 31>;
            timeout-ms = <50>;
        };

        bac {
            bindings = <&kp BACKSLASH>;
            key-positions = <5 6>;
        };

        pipe {
            bindings = <&kp PIPE>;
            key-positions = <17 18>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        INITIAL {
            bindings = <
&kp ESC    &kp Q  &kp W  &kp E      &kp R         &kp T        &kp Y           &kp U            &kp I             &kp O            &kp P             &kp BSPC
&kp TAB    &kp A  &kp S  &kp D      &kp F         &kp G        &kp H           &hm RSHIFT J     &hm RCTRL K       &hm RIGHT_ALT L  &kp LEFT_BRACKET  &hm SEMICOLON RBKT
&kp LSHFT  &kp Z  &kp X  &kp C      &kp V         &kp B        &kp N           &kp M            &kp COMMA         &kp DOT          &kp SLASH         &kp RIGHT_SHIFT
                         &kp LCTRL  &kp LEFT_ALT  &lt 2 ENTER  &lt 1 KP_ENTER  &lt 2 RIGHT_ALT  &ltq 3 BACKSPACE
            >;
        };

        lower_layer {
            bindings = <
&kp ESCAPE      &kp N1           &kp N2       &kp N3    &kp N4       &kp N5       &kp N6        &kp N7     &kp N8        &kp N9                &kp N0                 &kp BSPC
&kp TAB         &kp EXCLAMATION  &kp AT_SIGN  &kp HASH  &kp DOLLAR   &kp PERCENT  &kp CARET     &kp AMPS   &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &mo 4
&kt LEFT_SHIFT  &trans           &trans       &trans    &kp KP_PLUS  &kt MINUS    &kp ASTERISK  &kp EQUAL  &trans        &trans                &trans                 &kp RIGHT_SHIFT
                                              &trans    &trans       &trans       &trans        &trans     &trans
            >;
        };

        raise_layer {
            bindings = <
&kp HOME        &kp ESC         &kp UP_ARROW     &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp HOME  &kp HOME  &trans    &kp UP    &trans     &kp HOME  &kp DELETE
&kp END         &kp LEFT_ARROW  &kp DOWN_ARROW   &kp RIGHT_ARROW  &kp KP_NUMBER_6  &kp AT    &trans    &kp LEFT  &kp DOWN  &kp RIGHT  &trans    &mo 4
&kp LEFT_SHIFT  &kp DELETE      &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp END   &kp END   &trans    &trans    &trans     &kp END   &kp RIGHT_SHIFT
                                                 &kp LCTRL        &kp LEFT_ALT     &trans    &trans    &trans    &trans
            >;
        };

        layer_3 {
            bindings = <
&kp ESC         &kp F1      &kp F2           &kp F3           &kp F4           &kp F5   &kp F6   &kp F7    &kp F8    &kp F9     &kp F10  &kp DEL
&kp CAPSLOCK    &trans      &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp F11  &kp F12  &kp LEFT  &kp DOWN  &kp RIGHT  &trans   &trans
&kp LEFT_SHIFT  &kp DELETE  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp DOT  &trans   &trans    &trans    &trans     &trans   &kp RIGHT_SHIFT
                                             &kp LCTRL        &kp LEFT_ALT     &trans   &trans   &trans    &trans
            >;
        };

        RGB {
            bindings = <
&trans  &bt BT_DISC 0  &bt BT_DISC 1  &bt BT_DISC 2  &trans  &bt BT_CLR      &rgb_ug RGB_HUI  &rgb_ug RGB_SAI  &rgb_ug RGB_ON   &rgb_ug RGB_COLOR_HSB(118,100,50)  &rgb_ug RGB_SPD  &trans
&trans  &bt BT_NXT     &trans         &trans         &trans  &bt BT_CLR_ALL  &trans           &rgb_ug RGB_SAD  &rgb_ug RGB_TOG  &rgb_ug RGB_EFF                    &trans           &trans
&trans  &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &trans  &trans          &rgb_ug RGB_HUD  &trans           &rgb_ug RGB_HUD  &rgb_ug RGB_SPI                    &trans           &trans
                                      &trans         &trans  &trans          &trans           &trans           &trans
            >;
        };
    };
};
